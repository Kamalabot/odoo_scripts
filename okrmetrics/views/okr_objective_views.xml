<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Kanban View (Shows progress bar and stars) -->
        <record id="okr_objective_view_kanban" model="ir.ui.view">
            <field name="name">okrmetrics.objective.kanban</field>
            <field name="model">okrmetrics.objective</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="progress"/>
                    <field name="priority"/>
                    <field name="owner_id"/>
                    <field name="id"/>
                    <field name="color"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_color_{{record.color.raw_value}} oe_kanban_card oe_kanban_global_click">
                                <div class="o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <ul class="oe_kanban_colorpicker" data-field="color"/>
                                    </div>
                                </div>
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_title">
                                        <strong><field name="name"/></strong>
                                    </div>
                                    <div class="text-muted">
                                        <field name="priority" widget="priority"/>
                                    </div>
                                    <div class="mt-2">
                                        <!-- Progress Bar -->
                                        <field name="progress" widget="progressbar" options="{'max_value': 100}"/>
                                    </div>
                                    <div class="o_kanban_record_bottom mt-2">
                                        <div class="oe_kanban_bottom_left">
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <!-- Owner Avatar -->
                                            <img t-att-src="kanban_image('res.users', 'avatar_128', record.owner_id.raw_value)" t-att-title="record.owner_id.value" t-att-alt="record.owner_id.value" class="oe_kanban_avatar"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Tree View -->
        <record id="okr_objective_view_tree" model="ir.ui.view">
            <field name="name">okrmetrics.objective.tree</field>
            <field name="model">okrmetrics.objective</field>
            <field name="arch" type="xml">
                <tree string="Objectives">
                    <field name="name"/>
                    <field name="owner_id"/>
                    <field name="period_id"/>
                    <field name="priority" widget="priority"/>
                    <field name="progress" widget="progressbar"/>
                    <field name="state" badge_decoration="info" decoration-success="state == 'completed'"/>
                </tree>
            </field>
        </record>

        <!-- Form View with Chatter, Rich Text, Progressbar, Priority, and References -->
        <record id="okr_objective_view_form" model="ir.ui.view">
            <field name="name">okrmetrics.objective.form</field>
            <field name="model">okrmetrics.objective</field>
            <field name="arch" type="xml">
                <form string="Objective">
                    <header>
                        <button string="Activate" name="action_activate" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button string="Complete" name="action_complete" type="object" class="oe_highlight" invisible="state != 'active'"/>
                        <button string="Cancel" name="action_cancel" type="object" invisible="state in ('completed', 'cancelled')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,active,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="e.g. Launch New Mobile App..."/></h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="owner_id" widget="many2one_avatar"/>
                                <field name="team_id"/>
                                <field name="period_id"/>
                                <field name="priority" widget="priority"/>
                            </group>
                            <group>
                                <field name="level"/>
                                <field name="parent_id"/>
                                <field name="aligned_to" widget="reference"/>
                                <!-- Progress rendered read-only but clearly visible -->
                                <field name="progress" widget="progressbar" options="{'max_value': 100}"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Key Results">
                                <field name="key_result_ids">
                                    <tree editable="bottom" decoration-info="confidence=='3'" decoration-warning="confidence=='2'" decoration-danger="confidence=='1'">
                                        <field name="name"/>
                                        <field name="start_value"/>
                                        <field name="target_value"/>
                                        <field name="current_value"/>
                                        <field name="unit"/>
                                        <field name="confidence"/>
                                        <field name="progress" widget="progressbar"/>
                                        <button name="%(action_okrmetrics_checkin_wizard_dummy)d" type="action" icon="fa-pencil-square-o" title="Check-in... (dummy)"/>
                                    </tree>
                                    <!-- A wizard for check-ins would usually be linked here. 
                                         For this demo, users can expand the KR line to add check-ins. -->
                                    <form>
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="name"/>
                                                    <field name="target_value"/>
                                                    <field name="unit"/>
                                                </group>
                                                <group>
                                                    <field name="current_value" readonly="1"/>
                                                    <field name="confidence"/>
                                                    <field name="progress" widget="progressbar"/>
                                                </group>
                                            </group>
                                            <notebook>
                                                <page string="Check-ins">
                                                    <field name="check_in_ids">
                                                        <tree editable="bottom">
                                                            <field name="check_in_date"/>
                                                            <field name="value"/>
                                                            <field name="confidence"/>
                                                            <field name="note" widget="html"/>
                                                            <field name="owner_id"/>
                                                        </tree>
                                                    </field>
                                                </page>
                                            </notebook>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                            <page string="Description">
                                <field name="description"/> <!-- Used as rich text automatically by standard Odoo due to HTML type -->
                            </page>
                        </notebook>
                    </sheet>
                    
                    <!-- Chatter -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Dummy action for checkin to prevent XML parsing error in the tree -->
        <record id="action_okrmetrics_checkin_wizard_dummy" model="ir.actions.act_window">
             <field name="name">New Check-in</field>
             <field name="res_model">okrmetrics.check_in</field>
             <field name="view_mode">form</field>
             <field name="target">new</field>
        </record>

        <!-- Action -->
        <record id="action_okrmetrics_objective" model="ir.actions.act_window">
            <field name="name">Objectives</field>
            <field name="res_model">okrmetrics.objective</field>
            <field name="view_mode">kanban,tree,form</field>
        </record>
    </data>
</odoo>
