<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            IMPORTANT: The check-in action record is defined FIRST so that view records
            that reference it can resolve the XML ID during data loading.
        -->

        <!-- Check-in window action (opens as a popup dialog) -->
        <record id="action_okrmetrics_checkin_form" model="ir.actions.act_window">
            <field name="name">New Check-in</field>
            <field name="res_model">okrmetrics.check_in</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Window action for Objectives list/kanban/form/graph/pivot -->
        <record id="action_okrmetrics_objective" model="ir.actions.act_window">
            <field name="name">Objectives</field>
            <field name="res_model">okrmetrics.objective</field>
            <field name="view_mode">kanban,tree,form,graph,pivot</field>
        </record>

        <!-- =====================================================================
             KANBAN VIEW
             - Groups by state (Draft / Active / Completed / Cancelled)
             - Shows progress bar and priority stars on each card
             - Color picker for card color
             - Owner avatar at the bottom right
        ===================================================================== -->
        <record id="okr_objective_view_kanban" model="ir.ui.view">
            <field name="name">okrmetrics.objective.kanban</field>
            <field name="model">okrmetrics.objective</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state">
                    <field name="name"/>
                    <field name="progress"/>
                    <field name="priority"/>
                    <field name="owner_id"/>
                    <field name="color"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_color_#{record.color.raw_value} oe_kanban_card oe_kanban_global_click">
                                <!-- Color picker dropdown -->
                                <div class="o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret btn" role="button"
                                       data-bs-toggle="dropdown" href="#"
                                       aria-label="Dropdown menu" title="Dropdown menu">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <ul class="oe_kanban_colorpicker" data-field="color"/>
                                    </div>
                                </div>

                                <div class="oe_kanban_content">
                                    <!-- Objective title -->
                                    <div class="o_kanban_record_title">
                                        <strong><field name="name"/></strong>
                                    </div>

                                    <!-- Priority stars -->
                                    <div class="mt-1">
                                        <field name="priority" widget="priority"/>
                                    </div>

                                    <!-- Progress bar: 0–100 float rendered visually -->
                                    <div class="mt-2">
                                        <field name="progress" widget="progressbar"
                                               options="{'max_value': 100, 'editable': false}"/>
                                    </div>

                                    <div class="o_kanban_record_bottom mt-2">
                                        <div class="oe_kanban_bottom_left"/>
                                        <div class="oe_kanban_bottom_right">
                                            <!-- Owner avatar image -->
                                            <img t-att-src="kanban_image('res.users', 'avatar_128', record.owner_id.raw_value)"
                                                 t-att-title="record.owner_id.value"
                                                 t-att-alt="record.owner_id.value"
                                                 class="oe_kanban_avatar"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- =====================================================================
             TREE (LIST) VIEW
             - decoration-* for color-coded rows: info=on track, warning=at risk, danger=off track
             - progressbar widget shows inline fill bars
             - priority widget shows stars
        ===================================================================== -->
        <record id="okr_objective_view_tree" model="ir.ui.view">
            <field name="name">okrmetrics.objective.tree</field>
            <field name="model">okrmetrics.objective</field>
            <field name="arch" type="xml">
                <tree string="Objectives"
                      decoration-success="state == 'completed'"
                      decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="owner_id"/>
                    <field name="team_id"/>
                    <field name="period_id"/>
                    <field name="level"/>
                    <!--
                        widget="priority" on a tree field renders clickable stars.
                        The Selection values must be '0','1','2','3' for the widget to work.
                    -->
                    <field name="priority" widget="priority"/>
                    <field name="progress" widget="progressbar"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- =====================================================================
             FORM VIEW
             Layout:
               <header>  — Activate / Complete / Cancel buttons + status bar
               <sheet>
                 oe_title  — Objective name (h1)
                 group     — Two columns: owner/team/period/priority | level/parent/aligned_to/progress
                 notebook
                   page "Key Results" — inline editable list + embedded form with Check-ins tab
                   page "Description" — fields.Html WYSIWYG editor
               <oe_chatter> — mail.thread message log + followers + scheduled activities
        ===================================================================== -->
        <record id="okr_objective_view_form" model="ir.ui.view">
            <field name="name">okrmetrics.objective.form</field>
            <field name="model">okrmetrics.objective</field>
            <field name="arch" type="xml">
                <form string="Objective">

                    <!-- HEADER: workflow buttons + status bar progress indicator -->
                    <header>
                        <!--
                            type="object" → Odoo routes click to the Python method named in 'name'.
                            invisible= uses the new Odoo 16/17 inline domain syntax.
                            Falls back to attrs= for older versions.
                        -->
                        <button string="Activate"
                                name="action_activate"
                                type="object"
                                class="oe_highlight"
                                attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button string="Complete"
                                name="action_complete"
                                type="object"
                                class="oe_highlight"
                                attrs="{'invisible': [('state', '!=', 'active')]}"/>
                        <button string="Cancel"
                                name="action_cancel"
                                type="object"
                                attrs="{'invisible': [('state', 'in', ['cancelled', 'completed'])]}"/>
                        <!--
                            statusbar_visible controls which states appear as labeled steps.
                            'cancelled' is deliberately excluded — it's a dead-end state.
                        -->
                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="draft,active,completed"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="e.g. Launch the new mobile app..."/>
                            </h1>
                        </div>

                        <!-- Two-column metadata group -->
                        <group>
                            <group>
                                <!--
                                    many2one_avatar widget: shows avatar image next to the user name.
                                    Only works for res.users and res.partner.
                                -->
                                <field name="owner_id" widget="many2one_avatar"/>
                                <field name="team_id"/>
                                <field name="period_id"/>
                                <!--
                                    priority widget: renders interactive ★☆☆ stars.
                                    Requires Selection with string keys '0','1','2','3'.
                                -->
                                <field name="priority" widget="priority"/>
                            </group>
                            <group>
                                <field name="level"/>
                                <!-- Self-referential Many2one — links upward in the hierarchy -->
                                <field name="parent_id"/>
                                <!--
                                    fields.Reference widget: polymorphic — user first picks the model
                                    (e.g. "Another Objective") then the specific record.
                                    Stored as: aligned_to_type (VARCHAR) + aligned_to_id (INTEGER).
                                -->
                                <field name="aligned_to" widget="reference"/>
                                <!--
                                    progressbar widget: float 0–100 shown as a colored fill bar.
                                    editable=false because this is a computed field.
                                -->
                                <field name="progress"
                                       widget="progressbar"
                                       options="{'max_value': 100}"/>
                            </group>
                        </group>

                        <notebook>
                            <!-- KEY RESULTS TAB: inline editable list -->
                            <page string="Key Results">
                                <field name="key_result_ids">
                                    <!--
                                        editable="bottom": new rows added at the bottom of the list.
                                        decoration-*: color-code rows by confidence status.
                                        These require the 'confidence' field to be present in the tree.
                                    -->
                                    <tree editable="bottom"
                                          decoration-success="confidence == '3'"
                                          decoration-warning="confidence == '2'"
                                          decoration-danger="confidence == '1'">
                                        <field name="name" placeholder="e.g. Reach 10,000 MAU"/>
                                        <field name="start_value"/>
                                        <field name="target_value"/>
                                        <field name="current_value" readonly="1"/>
                                        <field name="unit" placeholder="e.g. users, %, ₹M"/>
                                        <field name="owner_id" optional="hide"/>
                                        <field name="confidence"/>
                                        <field name="progress" widget="progressbar"/>
                                        <!--
                                            Check-in button: opens a popup form for okrmetrics.check_in.
                                            type="action" + name=action_id opens the window action.
                                            context passes the key_result_id so the form pre-fills it.
                                        -->
                                        <button name="action_okrmetrics_checkin_form"
                                                type="action"
                                                icon="fa-plus-circle"
                                                title="Add Check-in"
                                                context="{'default_key_result_id': active_id}"/>
                                    </tree>

                                    <!--
                                        Embedded form: shown when user clicks a KR row to expand it.
                                        Contains the full Check-ins history as a nested One2many.
                                    -->
                                    <form>
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="name"/>
                                                    <field name="start_value"/>
                                                    <field name="target_value"/>
                                                    <field name="unit"/>
                                                </group>
                                                <group>
                                                    <!--
                                                        current_value is readonly here because it is
                                                        always set by the create() ORM hook on check_in.
                                                    -->
                                                    <field name="current_value" readonly="1"/>
                                                    <field name="confidence"/>
                                                    <field name="progress" widget="progressbar"
                                                           options="{'max_value': 100}"/>
                                                </group>
                                            </group>
                                            <notebook>
                                                <page string="Check-ins History">
                                                    <field name="check_in_ids">
                                                        <tree editable="bottom">
                                                            <field name="check_in_date"/>
                                                            <field name="value"/>
                                                            <field name="confidence"/>
                                                            <!--
                                                                widget="html" on a tree renders the
                                                                raw HTML; better in form view.
                                                                In tree, use a Text preview instead.
                                                            -->
                                                            <field name="owner_id"/>
                                                        </tree>
                                                    </field>
                                                </page>
                                            </notebook>
                                        </sheet>
                                    </form>
                                </field>
                            </page>

                            <!-- DESCRIPTION TAB: fields.Html renders full WYSIWYG editor -->
                            <page string="Description">
                                <!--
                                    fields.Html: stores raw HTML in a TEXT column.
                                    The view renders it as a rich-text editor automatically.
                                    No additional widget declaration needed.
                                -->
                                <field name="description"/>
                            </page>

                            <!-- ALIGNED OBJECTIVES TAB: child objectives in the hierarchy -->
                            <page string="Aligned Objectives">
                                <field name="child_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="owner_id"/>
                                        <field name="period_id"/>
                                        <field name="progress" widget="progressbar"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>

                    <!--
                        CHATTER: enabled by _inherit = ['mail.thread', 'mail.activity.mixin']
                        message_follower_ids: list of users/partners following this record.
                        activity_ids: scheduled activities (call, email reminder, etc.)
                        message_ids: the full conversation thread.
                    -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

    </data>
</odoo>
