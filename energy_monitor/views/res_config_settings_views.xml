<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.energy.monitor</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Energy Settings" string="Energy Settings" name="energy_monitor">
                    <block title="Energy Defaults" name="energy_defaults_setting_container">
                        <setting id="energy_alert_email" string="Alert Email" help="Email to notify for budget exceeded">
                            <field name="energy_alert_email"/>
                        </setting>

                        <setting id="default_rate_electricity" string="Default Electricity Rate" help="Global rate per unit">
                            <field name="default_rate_electricity"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_energy_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'energy_monitor'}</field>
    </record>

    <menuitem id="menu_energy_settings_action" action="action_energy_config_settings" parent="menu_energy_settings" sequence="10"/>
</odoo>
