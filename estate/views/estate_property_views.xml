<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            =====================================================================
            PROPERTY LIST VIEW (Tree)
            =====================================================================
            decoration-* attributes give conditional row styling:
            - success (green) = offer accepted
            - muted (grey)    = sold
            The fields listed in decoration-* must appear as <field> in the tree.
        -->
        <record id="estate_property_view_tree" model="ir.ui.view">
            <field name="name">estate.property.tree</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <tree string="Properties"
                      decoration-success="state == 'offer_accepted'"
                      decoration-muted="state == 'sold'">
                    <field name="name"/>
                    <field name="property_type_id" string="Type"/>
                    <field name="postcode"/>
                    <field name="bedrooms"/>
                    <field name="living_area"/>
                    <field name="expected_price"/>
                    <field name="best_price"/>
                    <field name="selling_price"/>
                    <field name="date_availability" optional="hide"/>
                    <field name="state"/>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                </tree>
            </field>
        </record>

        <!--
            =====================================================================
            PROPERTY FORM VIEW
            =====================================================================
            Layout:
              <header>   — Sell/Cancel buttons + status bar widget
              <sheet>
                oe_title — Property name + colored tag pills
                group    — Two-column layout: left=type/postcode/date, right=prices
                notebook
                  page "Description" — physical attributes + computed total_area
                  page "Offers"      — inline One2many list with Accept/Refuse buttons
        -->
        <record id="estate_property_view_form" model="ir.ui.view">
            <field name="name">estate.property.form</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <form string="Property">
                    <!--
                        HEADER: Odoo places buttons here as a bar at the top of the form.
                        type="object" → Odoo makes a JSON-RPC call to the Python method named in 'name'.
                        attrs invisible → hides the button based on state (client-side evaluation).
                        statusbar_visible lists the states shown as progress steps.
                    -->
                    <header>
                        <button name="action_sell"
                                type="object"
                                string="Sell"
                                attrs="{'invisible': [('state', 'in', ['sold', 'canceled'])]}"/>
                        <button name="action_cancel"
                                type="object"
                                string="Cancel"
                                attrs="{'invisible': [('state', 'in', ['sold', 'canceled'])]}"/>
                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="new,offer_received,offer_accepted,sold"/>
                    </header>

                    <sheet>
                        <!-- Title area: property name + tag pills side by side -->
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Property Name"/>
                            </h1>
                            <!--
                                many2many_tags widget: renders tags as colored pill badges.
                                options color_field tells Odoo which integer field drives the color.
                            -->
                            <field name="tag_ids"
                                   widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                        </div>

                        <!-- Two-column group layout -->
                        <group>
                            <group>
                                <!--
                                    Many2one field renders as a dropdown with search + quick-create.
                                    Clicking the external link icon opens the type's form view.
                                -->
                                <field name="property_type_id" options="{'no_create': False}"/>
                                <field name="postcode"/>
                                <field name="date_availability"/>
                            </group>
                            <group>
                                <field name="expected_price"/>
                                <!--
                                    best_price is a COMPUTED field — readonly, recalculated
                                    each time an offer's price changes (no DB column).
                                -->
                                <field name="best_price"/>
                                <field name="selling_price"/>
                            </group>
                        </group>

                        <notebook>
                            <!-- Tab 1: Physical description of the property -->
                            <page string="Description">
                                <group>
                                    <field name="description"/>
                                    <field name="bedrooms"/>
                                    <field name="living_area"/>
                                    <field name="facades"/>
                                    <field name="garage"/>
                                    <field name="garden"/>
                                    <field name="garden_area"/>
                                    <field name="garden_orientation"/>
                                    <!--
                                        total_area: computed from living_area + garden_area.
                                        Automatically updates in the UI as fields are edited.
                                    -->
                                    <field name="total_area"/>
                                </group>
                            </page>

                            <!-- Tab 2: Offer workflow — inline editable list -->
                            <page string="Offers">
                                <!--
                                    One2many inline list: renders all offers for this property.
                                    editable="bottom" lets users add new rows directly in the list.
                                    decoration-success/danger: row color based on status.
                                    icon buttons call Python methods via type="object".
                                -->
                                <field name="offer_ids">
                                    <tree string="Offers"
                                          editable="bottom"
                                          decoration-success="status == 'accepted'"
                                          decoration-danger="status == 'refused'">
                                        <field name="price"/>
                                        <field name="partner_id" string="Buyer"/>
                                        <field name="validity"/>
                                        <field name="date_deadline"/>
                                        <field name="status" optional="show"/>
                                        <!--
                                            Icon buttons: fa- classes are Font Awesome icons.
                                            These call action_accept/action_refuse on the offer record.
                                        -->
                                        <button name="action_accept"
                                                type="object"
                                                icon="fa-check"
                                                title="Accept this offer"
                                                attrs="{'invisible': [('status', '=', 'accepted')]}"/>
                                        <button name="action_refuse"
                                                type="object"
                                                icon="fa-times"
                                                title="Refuse this offer"
                                                attrs="{'invisible': [('status', '=', 'refused')]}"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!--
            =====================================================================
            PROPERTY SEARCH VIEW
            =====================================================================
            Controls what happens in the search bar.
            - <field>: user can type a value to search by that column.
            - <filter>: pre-built filter buttons (Available properties).
            - <group>: grouping options (Group By postcode or type).
        -->
        <record id="estate_property_view_search" model="ir.ui.view">
            <field name="name">estate.property.search</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <search string="Search Property">
                    <field name="name"/>
                    <field name="postcode"/>
                    <field name="property_type_id" string="Type"/>
                    <field name="expected_price"/>
                    <field name="bedrooms"/>
                    <field name="living_area" filter_domain="[('living_area', '&gt;=', self)]"/>

                    <separator/>

                    <filter string="Available"
                            name="available"
                            domain="[('state', 'in', ('new', 'offer_received'))]"/>

                    <group expand="1" string="Group By">
                        <filter string="Postcode"
                                name="group_by_postcode"
                                context="{'group_by': 'postcode'}"/>
                        <filter string="Property Type"
                                name="group_by_type"
                                context="{'group_by': 'property_type_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!--
            =====================================================================
            WINDOW ACTION: links menus to the model + views
            =====================================================================
        -->
        <record id="estate_property_action" model="ir.actions.act_window">
            <field name="name">Properties</field>
            <field name="res_model">estate.property</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first real estate property!
                </p>
            </field>
        </record>
    </data>
</odoo>
